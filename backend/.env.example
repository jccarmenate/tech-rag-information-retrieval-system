# Copy this file to .env and fill in the values you need.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Optional: raises GitHub's unauthenticated rate limit for the acquisition connector.
GITHUB_TOKEN=

# How often (hours) the acquisition scheduler refreshes the corpus.
ACQUISITION_INTERVAL_HOURS=6
ACQUISITION_LIMIT_PER_SOURCE=20

# Vector store / embeddings
CHROMA_PERSIST_DIR=data/chroma
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
